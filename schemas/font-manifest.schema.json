{
  "$defs": {
    "CatalogId": {
      "description": "Registry id of a catalog item. Validated by registry lookup.",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,47}$",
      "type": "string"
    },
    "Digest": {
      "description": "Lowercase SHA-256 hex.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "FontManifest": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/FontRelPath"
        },
        "id": {
          "$ref": "#/$defs/CatalogId"
        },
        "label": {
          "$ref": "#/$defs/LocalizedText"
        },
        "license": {
          "$ref": "#/$defs/License"
        },
        "pixel_size": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 6,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pixel Size"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scripts": {
          "items": {
            "$ref": "#/$defs/FontScript"
          },
          "minItems": 1,
          "title": "Scripts",
          "type": "array",
          "uniqueItems": true
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "schema_version",
        "id",
        "label",
        "file",
        "sha256",
        "scripts",
        "pixel_size",
        "license"
      ],
      "title": "FontManifest",
      "type": "object"
    },
    "FontRelPath": {
      "not": {
        "pattern": "\\.\\.|//"
      },
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,127}\\.(ttf|otf)$",
      "type": "string"
    },
    "FontScript": {
      "enum": [
        "hangul",
        "latin",
        "digits"
      ],
      "title": "FontScript",
      "type": "string"
    },
    "License": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "author": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "commercial_ok": {
          "title": "Commercial Ok",
          "type": "boolean"
        },
        "license_file": {
          "$ref": "#/$defs/RelPath"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "spdx": {
          "pattern": "^[A-Za-z0-9.+-]{2,40}$",
          "title": "Spdx",
          "type": "string"
        }
      },
      "required": [
        "spdx",
        "source_url",
        "author",
        "commercial_ok",
        "attribution",
        "license_file"
      ],
      "title": "License",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "maxLength": 200,
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "ko": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ko",
          "type": "string"
        }
      },
      "required": [
        "ko",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "RelPath": {
      "description": "Relative path inside a package or data root. No absolute path, no parent segment, no backslash.",
      "not": {
        "pattern": "\\.\\.|//"
      },
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "https://app.invalid/schemas/font-manifest.schema.json",
  "$ref": "#/$defs/FontManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "core/app/plugins/fonts/<id>/manifest.json.",
  "title": "Font manifest"
}
