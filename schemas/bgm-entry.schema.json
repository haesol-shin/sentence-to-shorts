{
  "$defs": {
    "BgmParams": {
      "additionalProperties": false,
      "properties": {
        "bars": {
          "maximum": 16,
          "minimum": 1,
          "title": "Bars",
          "type": "integer"
        },
        "bpm": {
          "maximum": 180,
          "minimum": 60,
          "title": "Bpm",
          "type": "integer"
        },
        "mood": {
          "$ref": "#/$defs/Mood"
        }
      },
      "required": [
        "bpm",
        "bars",
        "mood"
      ],
      "title": "BgmParams",
      "type": "object"
    },
    "BgmRelPath": {
      "not": {
        "pattern": "\\.\\.|//"
      },
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,127}\\.(wav|ogg)$",
      "type": "string"
    },
    "BuiltinBgm": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "enum": [
            1,
            2
          ],
          "title": "Channels",
          "type": "integer"
        },
        "duration_ms": {
          "maximum": 600000,
          "minimum": 500,
          "title": "Duration Ms",
          "type": "integer"
        },
        "file": {
          "$ref": "#/$defs/BgmRelPath"
        },
        "id": {
          "$ref": "#/$defs/CatalogId"
        },
        "label": {
          "$ref": "#/$defs/LocalizedText"
        },
        "license": {
          "$ref": "#/$defs/License"
        },
        "loudness_lufs_x10": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -700,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Loudness Lufs X10"
        },
        "mood": {
          "$ref": "#/$defs/Mood"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "sample_rate": {
          "enum": [
            44100,
            48000
          ],
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "source": {
          "const": "builtin",
          "title": "Source",
          "type": "string"
        },
        "true_peak_dbtp_x10": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "True Peak Dbtp X10"
        }
      },
      "required": [
        "schema_version",
        "id",
        "label",
        "mood",
        "file",
        "sha256",
        "duration_ms",
        "sample_rate",
        "channels",
        "loudness_lufs_x10",
        "true_peak_dbtp_x10",
        "source",
        "license",
        "review_status"
      ],
      "title": "BuiltinBgm",
      "type": "object"
    },
    "CatalogId": {
      "description": "Registry id of a catalog item. Validated by registry lookup.",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,47}$",
      "type": "string"
    },
    "CodeBgm": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "const": 1,
          "title": "Channels",
          "type": "integer"
        },
        "duration_ms": {
          "maximum": 16000,
          "minimum": 500,
          "title": "Duration Ms",
          "type": "integer"
        },
        "file": {
          "$ref": "#/$defs/WavRelPath"
        },
        "id": {
          "$ref": "#/$defs/CatalogId"
        },
        "label": {
          "$ref": "#/$defs/LocalizedText"
        },
        "loudness_lufs_x10": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -700,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Loudness Lufs X10"
        },
        "mood": {
          "$ref": "#/$defs/Mood"
        },
        "params": {
          "$ref": "#/$defs/BgmParams"
        },
        "program": {
          "$ref": "#/$defs/RelPath"
        },
        "program_digest": {
          "$ref": "#/$defs/Digest"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "runtime_digest": {
          "$ref": "#/$defs/Digest"
        },
        "sample_rate": {
          "const": 44100,
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "source": {
          "const": "code",
          "title": "Source",
          "type": "string"
        },
        "true_peak_dbtp_x10": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "True Peak Dbtp X10"
        }
      },
      "required": [
        "schema_version",
        "id",
        "label",
        "mood",
        "file",
        "sha256",
        "duration_ms",
        "sample_rate",
        "channels",
        "loudness_lufs_x10",
        "true_peak_dbtp_x10",
        "source",
        "program",
        "program_digest",
        "runtime_digest",
        "seed",
        "params",
        "provenance"
      ],
      "title": "CodeBgm",
      "type": "object"
    },
    "Digest": {
      "description": "Lowercase SHA-256 hex.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityId": {
      "description": "App-issued id. Prefix p project, v video, s scene, l line, e element, c change, j job, a artifact, u upload, ps preset, rf reference.",
      "pattern": "^[a-z]{1,2}_[0-7][0-9a-hjkmnp-tv-z]{25}$",
      "type": "string"
    },
    "License": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "author": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "commercial_ok": {
          "title": "Commercial Ok",
          "type": "boolean"
        },
        "license_file": {
          "$ref": "#/$defs/RelPath"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "spdx": {
          "pattern": "^[A-Za-z0-9.+-]{2,40}$",
          "title": "Spdx",
          "type": "string"
        }
      },
      "required": [
        "spdx",
        "source_url",
        "author",
        "commercial_ok",
        "attribution",
        "license_file"
      ],
      "title": "License",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "maxLength": 200,
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "ko": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ko",
          "type": "string"
        }
      },
      "required": [
        "ko",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "Mood": {
      "enum": [
        "curious",
        "playful",
        "tense",
        "energetic",
        "calm",
        "reflective"
      ],
      "title": "Mood",
      "type": "string"
    },
    "OwnerId": {
      "pattern": "^[a-z0-9_-]{1,32}$",
      "type": "string"
    },
    "PinnedRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/CatalogId"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "PinnedRef",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Generated package origin. Never contains prompts, URLs or user text.",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/EntityId"
        },
        "model": {
          "maxLength": 80,
          "title": "Model",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/PinnedRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "maxLength": 40,
          "title": "Provider",
          "type": "string"
        },
        "reference_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "request_digest",
        "parent",
        "reference_digest",
        "job_id",
        "provider",
        "model"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RelPath": {
      "description": "Relative path inside a package or data root. No absolute path, no parent segment, no backslash.",
      "not": {
        "pattern": "\\.\\.|//"
      },
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,127}$",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "verified",
        "pending"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SfxEntry": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "maximum": 5000,
          "minimum": 20,
          "title": "Duration Ms",
          "type": "integer"
        },
        "file": {
          "$ref": "#/$defs/WavRelPath"
        },
        "id": {
          "$ref": "#/$defs/CatalogId"
        },
        "kind": {
          "$ref": "#/$defs/SfxKind"
        },
        "label": {
          "$ref": "#/$defs/LocalizedText"
        },
        "license": {
          "$ref": "#/$defs/License"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "schema_version",
        "id",
        "label",
        "kind",
        "file",
        "sha256",
        "duration_ms",
        "license"
      ],
      "title": "SfxEntry",
      "type": "object"
    },
    "SfxKind": {
      "enum": [
        "whoosh",
        "pop",
        "ding",
        "click",
        "typing",
        "impact",
        "riser"
      ],
      "title": "SfxKind",
      "type": "string"
    },
    "Timestamp": {
      "description": "ISO 8601 date-time with a timezone.",
      "format": "date-time",
      "type": "string"
    },
    "UploadBgm": {
      "additionalProperties": false,
      "properties": {
        "accepted_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "channels": {
          "enum": [
            1,
            2
          ],
          "title": "Channels",
          "type": "integer"
        },
        "duration_ms": {
          "maximum": 600000,
          "minimum": 500,
          "title": "Duration Ms",
          "type": "integer"
        },
        "file": {
          "$ref": "#/$defs/WavRelPath"
        },
        "id": {
          "$ref": "#/$defs/CatalogId"
        },
        "label": {
          "$ref": "#/$defs/LocalizedText"
        },
        "loudness_lufs_x10": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -700,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Loudness Lufs X10"
        },
        "mood": {
          "$ref": "#/$defs/Mood"
        },
        "original_bytes": {
          "minimum": 1,
          "title": "Original Bytes",
          "type": "integer"
        },
        "owner_id": {
          "$ref": "#/$defs/OwnerId"
        },
        "project_id": {
          "$ref": "#/$defs/EntityId"
        },
        "sample_rate": {
          "enum": [
            44100,
            48000
          ],
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "source": {
          "const": "upload",
          "title": "Source",
          "type": "string"
        },
        "true_peak_dbtp_x10": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "True Peak Dbtp X10"
        },
        "upload_id": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "schema_version",
        "id",
        "label",
        "mood",
        "file",
        "sha256",
        "duration_ms",
        "sample_rate",
        "channels",
        "loudness_lufs_x10",
        "true_peak_dbtp_x10",
        "source",
        "owner_id",
        "project_id",
        "upload_id",
        "original_bytes",
        "accepted_at"
      ],
      "title": "UploadBgm",
      "type": "object"
    },
    "WavRelPath": {
      "not": {
        "pattern": "\\.\\.|//"
      },
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,127}\\.wav$",
      "type": "string"
    }
  },
  "$id": "https://app.invalid/schemas/bgm-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One BGM source: builtin, uploaded or generated loop.",
  "discriminator": {
    "mapping": {
      "builtin": "#/$defs/BuiltinBgm",
      "code": "#/$defs/CodeBgm",
      "upload": "#/$defs/UploadBgm"
    },
    "propertyName": "source"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/BuiltinBgm"
    },
    {
      "$ref": "#/$defs/UploadBgm"
    },
    {
      "$ref": "#/$defs/CodeBgm"
    }
  ],
  "title": "BGM entry"
}
